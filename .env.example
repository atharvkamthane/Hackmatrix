NODE_ENV=development
PORT=3000

# Expo mobile (public by design; never put a Clerk secret here).
EXPO_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_replace_me
# Use your LAN IP instead of localhost when testing on a physical phone.
EXPO_PUBLIC_API_BASE_URL=http://localhost:3000

# MongoDB Atlas. Keep the password out of Git.
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/
MONGODB_CLINICAL_DB=hackmatrix_clinical
MONGODB_ANALYTICS_DB=hackmatrix_analytics

# Clerk backend configuration. Keep the secret key out of Git.
CLERK_SECRET_KEY=sk_test_replace_me
CLERK_AUTHORIZED_PARTIES=http://localhost:8081,http://localhost:5173
CLERK_ROLE_CLAIM=metadata.role

CORS_ORIGINS=http://localhost:8081,http://localhost:5173
LOG_LEVEL=info
BODY_LIMIT=1mb
