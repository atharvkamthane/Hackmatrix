# ==============================================================================
# HackMatrix Environment Configuration Template (.env.example)
# Copy this file to .env and replace the placeholder values.
# NEVER commit real secret keys, credentials, or production tokens to Git.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. BACKEND CORE CONFIGURATION (Required for API server)
# ------------------------------------------------------------------------------
NODE_ENV=development
PORT=5000
CORS_ORIGINS=http://localhost:3000,http://localhost:8081,http://localhost:19006
LOG_LEVEL=info
BODY_LIMIT=1mb

# ------------------------------------------------------------------------------
# 2. MONGODB CONFIGURATION (Required for clinical and analytics persistence)
# ------------------------------------------------------------------------------
# For local MongoDB (default for local development):
MONGODB_URI=mongodb://127.0.0.1:27017
# For MongoDB Atlas (production / staging):
# MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/?appName=HackMatrix
MONGODB_DATABASE=hackmatrix

# ------------------------------------------------------------------------------
# 3. CLERK AUTHENTICATION (Required for server-side token & role verification)
# ------------------------------------------------------------------------------
# Backend Secret Key (NEVER expose to frontend/clients)
CLERK_SECRET_KEY=sk_test_your_clerk_secret_key_here
# Backend Publishable Key (used by Clerk client verifier)
CLERK_PUBLISHABLE_KEY=pk_test_your_clerk_publishable_key_here
# Authorized client origins allowed to authenticate against backend
CLERK_AUTHORIZED_PARTIES=http://localhost:3000,http://localhost:8081,http://localhost:19006
# JWT session claim key containing server-assigned role (PATIENT | CLINICIAN | ADMIN)
CLERK_ROLE_CLAIM=metadata.role

# ------------------------------------------------------------------------------
# 4. MOBILE / FRONTEND CONFIGURATION (Expo Client)
# ------------------------------------------------------------------------------
# Public Clerk Publishable Key for mobile/web client authentication
EXPO_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_your_clerk_publishable_key_here
# API Server base URL. When testing on a physical mobile device via Expo Go,
# replace localhost with your development machine's LAN IP address (e.g., http://192.168.1.100:5000).
EXPO_PUBLIC_API_BASE_URL=http://localhost:5000

# Administrator website public key (safe to expose in the browser)
VITE_CLERK_PUBLISHABLE_KEY=pk_test_your_clerk_publishable_key_here
